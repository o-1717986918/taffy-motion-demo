{
  "name": "taffy-motion-demo",
  "description": "Local first virtual avatar motion capture and voice conversion desktop demo",
  "author": "Local Taffy Motion Project",
  "license": "MIT",
  "version": "0.6.2",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:voice-live": "node scripts/e2e-voice-live.mjs",
    "test:e2e:voice-cold": "node scripts/e2e-voice-cold-start.mjs",
    "test:e2e:desktop-voice": "node scripts/e2e-desktop-voice-persistence.mjs",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "postinstall": "node scripts/sync-runtime.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1"
  },
  "dependencies": {
    "@babylonjs/core": "9.26.0",
    "@babylonjs/loaders": "9.26.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "babylon-mmd": "1.3.0",
    "lucide-react": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "latest",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
